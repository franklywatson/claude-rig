{
  "name": "rig",
  "version": "0.16.0",
  "description": "Agent harness that enforces tool routing, skill chains, and multi-agent discipline in Claude Code",
  "type": "module",
  "main": "dist/cli/index.js",
  "exports": {
    "./*": "./dist/*"
  },
  "bin": {
    "rig": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js",
    "eval": "npx tsx evals/runner.ts",
    "postinstall": "node -e \"const{symlinkSync,existsSync,mkdirSync}=require('fs');const{resolve}=require('path');const bin=resolve(process.env.HOME,'.local/bin');if(!existsSync(bin))mkdirSync(bin,{recursive:true});const target=resolve(__dirname,'dist/cli/index.js');const link=resolve(bin,'rig');try{symlinkSync(target,link)}catch(e){if(e.code!=='EEXIST')throw e}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:versions": "tsx scripts/sync-tested-versions.ts",
    "settle:deps": "tsx scripts/settle-deps-conflict.ts",
    "lint": "tsc --noEmit",
    "lint:md": "markdownlint-cli2 '**/*.md'"
  },
  "keywords": [
    "claude-code",
    "agent-harness",
    "guardrails"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.1",
    "markdownlint-cli2": "^0.23.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
